{
  "name": "abhi-hr-portal",
  "version": "0.1.0",
  "private": true,
  "description": "ABHI Microfinance Bank: talent acquisition, onboarding and HR portal",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p ${PORT:-3100}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "seed:reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\""
  },
  "dependencies": {
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
